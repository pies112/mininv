   "source": "# 4. Финальная обработка патентной базы\n\nНоутбук берет готовый файл `3_patents_2020_2025_final.xlsx`, удаляет единственный объект со статусом `parse_validation_failed`, при необходимости обращается к исходным реестрам Роспатента и формирует финальную книгу.\n\nДля **всех шести типов объектов** добавляются страны регистрации, авторов и правообладателей. Для классических патентов применяется консервативное правило международности: если подтвержденной зарубежной страны или международного маршрута нет, объект считается российским (`RU`, международность `0`). Промышленные образцы сохраняются с международностью и цитируемостью `0`.\n\nЗапустите ячейку ниже целиком."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "from __future__ import annotations\n\nimport ast\nimport csv\nimport json\nimport re\nimport unicodedata\nfrom collections import defaultdict\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Iterable\n\nimport numpy as np\nimport pandas as pd\n\n# ============================================================\n# 1. НАСТРОЙКИ\n# ============================================================\n\nVERSION = 4\n\nPROJECT_ROOT = Path(\n    '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n    'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n    'Инженерный проект/Версия рейтинга 1'\n)\n\nINPUT_FILENAME = '3_patents_2020_2025_final.xlsx'\nOUTPUT_DIR = PROJECT_ROOT / 'Выгрузка данных' / '4_Финальная патентная база 2020-2025'\nOUTPUT_XLSX = OUTPUT_DIR / '4_patents_2020_2025_final_clean.xlsx'\nOUTPUT_PARQUET = OUTPUT_DIR / '4_patents_2020_2025_final_clean.parquet'\nOUTPUT_CSV = OUTPUT_DIR / '4_patents_2020_2025_final_clean_all.csv'\nOUTPUT_REMOVED = OUTPUT_DIR / '4_removed_parse_validation_failed.csv'\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\nROSPATENT_FILES = {\n    'ТИМС': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр топологий интегральных микросхем.csv'\n    ),\n    'Промышленный образец': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр промышленных образцов Российской Федерации.csv'\n    ),\n    'Программа для ЭВМ': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр программ для электронно-вычислительных машин.csv'\n    ),\n    'Полезная модель': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр полезных моделей Российской Федерации.csv'\n    ),\n    'Изобретение': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр изобретений Российской Федерации.csv'\n    ),\n    'База данных': Path(\n        '/Users/vsevolodkarass/Library/Mobile Documents/com~apple~CloudDocs/'\n        'Desktop/Рабочий стол — MacBook Air — Всеволод/'\n        'Инженерный проект/Версия рейтинга 1/Выгрузка данных/Роспатент/'\n        'Открытый реестр баз данных.csv'\n    ),\n}\n\nOBJECT_TYPES = [\n    'Изобретение',\n    'Полезная модель',\n    'Промышленный образец',\n    'Программа для ЭВМ',\n    'База данных',\n    'ТИМС',\n]\nCLASSIC_TYPES = {'Изобретение', 'Полезная модель', 'Промышленный образец'}\nDIGITAL_TYPES = {'Программа для ЭВМ', 'База данных', 'ТИМС'}\nROUTE_CODES = {'WO', 'EP', 'EA', 'AP', 'OA', 'GC', 'EM', 'IB', 'PCT'}\nISO2_CODES = set('''AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI VN VU WF WS YE YT ZA ZM ZW'''.split())\n\n# ============================================================\n# 2. ОБЩИЕ ФУНКЦИИ\n# ============================================================\n\ndef norm_text(value: Any) -> str:\n    return unicodedata.normalize('NFC', str(value)).replace('\\xa0', ' ').strip()\n\ndef norm_filename(value: Any) -> str:\n    return norm_text(value).casefold()\n\ndef norm_col(value: Any) -> str:\n    return re.sub(r'[^a-zа-яё0-9]+', '_', norm_text(value).casefold()).strip('_')\n\ndef is_blank(value: Any) -> bool:\n    if value is None:\n        return True\n    try:\n        if pd.isna(value):\n            return True\n    except (TypeError, ValueError):\n        pass\n    return str(value).strip().casefold() in {'', 'nan', 'none', 'null', '[]', '{}'}\n\ndef resolve_path(path: Path) -> Path:\n    if path.exists():\n        return path\n    parent = path.parent\n    target = norm_filename(path.name)\n    if parent.exists():\n        for candidate in parent.iterdir():\n            if norm_filename(candidate.name) == target:\n                return candidate\n    for root in [PROJECT_ROOT, PROJECT_ROOT.parent, Path.cwd(), Path.home() / 'Downloads']:\n        if not root.exists():\n            continue\n        for candidate in root.rglob(path.name):\n            if norm_filename(candidate.name) == target:\n                return candidate\n    raise FileNotFoundError(f'Не найден файл: {path}')\n\ndef find_input_xlsx() -> Path:\n    candidates = [\n        PROJECT_ROOT / 'Выгрузка данных' / '3_Финальная патентная база 2020-2025' / INPUT_FILENAME,\n        PROJECT_ROOT / 'Выгрузка данных' / INPUT_FILENAME,\n        PROJECT_ROOT / INPUT_FILENAME,\n        Path.cwd() / INPUT_FILENAME,\n        Path.home() / 'Downloads' / INPUT_FILENAME,\n    ]\n    for candidate in candidates:\n        if candidate.exists():\n            return candidate\n    target = norm_filename(INPUT_FILENAME)\n    for root in [PROJECT_ROOT, PROJECT_ROOT.parent, Path.cwd(), Path.home() / 'Downloads']:\n        if root.exists():\n            for candidate in root.rglob('*.xlsx'):\n                if norm_filename(candidate.name) == target:\n                    return candidate\n    raise FileNotFoundError(f'Не найден {INPUT_FILENAME}')\n\ndef find_column(df: pd.DataFrame, candidates: Iterable[str], contains: Iterable[str] = ()) -> str | None:\n    by_norm = {norm_col(column): column for column in df.columns}\n    for candidate in candidates:\n        if norm_col(candidate) in by_norm:\n            return by_norm[norm_col(candidate)]\n    contains_norm = [norm_col(item) for item in contains]\n    for normalized, original in by_norm.items():\n        if any(fragment in normalized for fragment in contains_norm):\n            return original\n    return None\n\ndef parse_structured(value: Any) -> Any:\n    if is_blank(value):\n        return None\n    if isinstance(value, (dict, list, tuple, set)):\n        return value\n    text = str(value).strip()\n    for parser in (json.loads, ast.literal_eval):\n        try:\n            return parser(text)\n        except Exception:\n            continue\n    return text\n\ndef flatten(value: Any) -> str:\n    if value is None:\n        return ''\n    if isinstance(value, dict):\n        return ' '.join(flatten(item) for item in value.values())\n    if isinstance(value, (list, tuple, set)):\n        return ' '.join(flatten(item) for item in value)\n    return str(value)\n\ndef normalize_registration(value: Any) -> str:\n    if is_blank(value):\n        return ''\n    text = norm_text(value).upper()\n    return re.sub(r'[^A-ZА-Я0-9]', '', text)\n\ndef extract_codes_from_value(value: Any) -> set[str]:\n    result: set[str] = set()\n    parsed = parse_structured(value)\n\n    def walk(obj: Any, parent_key: str = '') -> None:\n        if obj is None:\n            return\n        if isinstance(obj, dict):\n            for key, item in obj.items():\n                key_norm = norm_col(key)\n                if 'country' in key_norm or 'страна' in key_norm:\n                    text = flatten(item).upper()\n                    result.update(code for code in re.findall(r'\\b[A-Z]{2}\\b', text) if code in ISO2_CODES)\n                walk(item, key_norm)\n            return\n        if isinstance(obj, (list, tuple, set)):\n            for item in obj:\n                walk(item, parent_key)\n            return\n        text = str(obj)\n        result.update(code for code in re.findall(r'\\(([A-Z]{2})\\)', text.upper()) if code in ISO2_CODES)\n        for pattern in [\n            r'(?i)(?:country|country_code|страна|код страны)\\s*[:=]\\s*[\\\"\\\']?([A-Z]{2})',\n            r'(?i)[\\\"\\\'](?:country|country_code|страна)[\\\"\\\']\\s*:\\s*[\\\"\\\']([A-Z]{2})',\n        ]:\n            result.update(code.upper() for code in re.findall(pattern, text) if code.upper() in ISO2_CODES)\n\n    walk(parsed)\n    return result\n\ndef extract_simple_code_list(value: Any) -> set[str]:\n    if is_blank(value):\n        return set()\n    text = flatten(parse_structured(value)).upper()\n    return {code for code in re.findall(r'\\b[A-Z]{2}\\b', text) if code in ISO2_CODES}\n\ndef extract_routes(value: Any) -> set[str]:\n    if is_blank(value):\n        return set()\n    text = flatten(parse_structured(value)).upper()\n    result = {code for code in ROUTE_CODES if re.search(rf'\\b{re.escape(code)}\\b', text)}\n    if 'PCT' in text:\n        result.add('PCT')\n    return result\n\ndef extract_ipc(value: Any) -> set[str]:\n    if is_blank(value):\n        return set()\n    text = flatten(parse_structured(value)).upper()\n    full = set(re.findall(r'\\b[A-HY]\\d{2}[A-Z]\\s*\\d{1,4}(?:/\\d{1,8})?\\b', text))\n    if full:\n        return {re.sub(r'\\s+', ' ', code.strip()) for code in full}\n    return set(re.findall(r'\\b[A-HY]\\d{2}[A-Z]\\b', text))\n\ndef extract_cpc(value: Any) -> set[str]:\n    return extract_ipc(value)\n\ndef extract_locarno(value: Any) -> set[str]:\n    if is_blank(value):\n        return set()\n    text = flatten(parse_structured(value))\n    return {code.replace('.', '-') for code in re.findall(r'\\b\\d{1,2}[-.]\\d{1,2}\\b', text)}\n\ndef serialize(values: Iterable[str]) -> str:\n    return '; '.join(sorted({str(value).strip().upper() for value in values if str(value).strip()}))\n\ndef infer_object_type(sheet_name: str, df: pd.DataFrame) -> pd.Series:\n    object_col = find_column(df, ['object_type', 'тип объекта'])\n    if object_col:\n        return df[object_col].fillna('').astype(str).map(norm_text)\n    name = sheet_name.casefold()\n    mapping = [\n        ('изобрет', 'Изобретение'),\n        ('полез', 'Полезная модель'),\n        ('промышлен', 'Промышленный образец'),\n        ('программ', 'Программа для ЭВМ'),\n        ('баз', 'База данных'),\n        ('тимс', 'ТИМС'),\n        ('тополог', 'ТИМС'),\n    ]\n    for fragment, object_type in mapping:\n        if fragment in name:\n            return pd.Series(object_type, index=df.index, dtype='object')\n    return pd.Series('', index=df.index, dtype='object')\n\ndef sniff_csv(path: Path) -> tuple[str, str]:\n    encodings = ['utf-8-sig', 'utf-8', 'cp1251']\n    for encoding in encodings:\n        try:\n            sample = path.read_text(encoding=encoding, errors='strict')[:100000]\n            delimiter = ';' if sample.count(';') >= sample.count(',') else ','\n            return encoding, delimiter\n        except UnicodeDecodeError:\n            continue\n    return 'utf-8-sig', ';'\n\n# ============================================================\n# 3. ЧТЕНИЕ ГОТОВОЙ КНИГИ ВЕРСИИ 3\n# ============================================================\n\nINPUT_XLSX = find_input_xlsx()\nprint('Исходная книга:', INPUT_XLSX)\nall_sheets = pd.read_excel(INPUT_XLSX, sheet_name=None, dtype=object)\n\ndata_parts: list[pd.DataFrame] = []\nservice_sheets: dict[str, pd.DataFrame] = {}\nfor sheet_name, sheet_df in all_sheets.items():\n    patent_col = find_column(sheet_df, ['patent_key'])\n    registration_col = find_column(sheet_df, ['registration_number', 'номер регистрации'])\n    university_col = find_column(sheet_df, ['university_canonical', 'унифицированное название вуза'])\n    inferred = infer_object_type(sheet_name, sheet_df)\n    is_data = patent_col is not None and registration_col is not None and university_col is not None and inferred.ne('').any()\n    if is_data:\n        part = sheet_df.copy()\n        part['source_sheet_original'] = sheet_name\n        part['object_type'] = inferred\n        data_parts.append(part)\n    else:\n        service_sheets[sheet_name] = sheet_df\n\nif not data_parts:\n    raise RuntimeError('В исходной книге не найдены листы с патентными данными.')\n\nfinal = pd.concat(data_parts, ignore_index=True, sort=False)\npatent_key_col = find_column(final, ['patent_key'])\nregistration_col = find_column(final, ['registration_number', 'номер регистрации'])\nuniversity_col = find_column(final, ['university_canonical', 'унифицированное название вуза'])\nstatus_col = find_column(final, ['gp_status', 'google_status'])\n\nfinal['registration_key_v4'] = final[registration_col].map(normalize_registration)\n\n# Удаляем весь объект по patent_key, если хотя бы одна его строка parse_validation_failed.\nif status_col:\n    bad_mask = final[status_col].fillna('').astype(str).str.strip().str.casefold().eq('parse_validation_failed')\n    bad_keys = set(final.loc[bad_mask, patent_key_col].dropna().astype(str))\nelse:\n    bad_keys = set()\nremoved = final.loc[final[patent_key_col].astype(str).isin(bad_keys)].copy()\nfinal = final.loc[~final[patent_key_col].astype(str).isin(bad_keys)].reset_index(drop=True)\nremoved.to_csv(OUTPUT_REMOVED, index=False, encoding='utf-8-sig')\nprint(f'Удалено невалидных patent_key: {len(bad_keys)}; строк: {len(removed)}')\n\n# ============================================================\n# 4. ТОЧЕЧНОЕ ЧТЕНИЕ ОРИГИНАЛЬНЫХ РЕЕСТРОВ РОСПАТЕНТА\n# ============================================================\n\nneeded_by_type = {\n    object_type: set(final.loc[final['object_type'].eq(object_type), 'registration_key_v4'].dropna()) - {''}\n    for object_type in OBJECT_TYPES\n}\n\nregistry_lookup: dict[str, dict[str, dict[str, str]]] = {object_type: {} for object_type in OBJECT_TYPES}\nregistry_qc: list[dict[str, Any]] = []\n\nfor object_type, configured_path in ROSPATENT_FILES.items():\n    path = resolve_path(configured_path)\n    encoding, sep = sniff_csv(path)\n    header = pd.read_csv(path, sep=sep, encoding=encoding, nrows=0).columns.tolist()\n    normalized = {norm_col(column): column for column in header}\n    registration_source_col = None\n    for candidate in ['registration_number', 'registration number', 'номер регистрации']:\n        if norm_col(candidate) in normalized:\n            registration_source_col = normalized[norm_col(candidate)]\n            break\n    if registration_source_col is None:\n        for key, original in normalized.items():\n            if 'registration' in key and 'number' in key:\n                registration_source_col = original\n                break\n    if registration_source_col is None:\n        raise KeyError(f'Не найден номер регистрации в {path.name}')\n\n    selected = [registration_source_col]\n    for column in header:\n        key = norm_col(column)\n        if any(fragment in key for fragment in [\n            'author', 'автор', 'inventor', 'holder', 'right_holder', 'patent_holder',\n            'правооблад', 'country', 'страна', 'ipc', 'мпк', 'locarno', 'локарно',\n        ]):\n            selected.append(column)\n    selected = list(dict.fromkeys(selected))\n\n    needed = needed_by_type.get(object_type, set())\n    matched_keys: set[str] = set()\n    for chunk in pd.read_csv(\n        path, sep=sep, encoding=encoding, dtype=str, usecols=selected, chunksize=100000,\n        keep_default_na=False, on_bad_lines='skip', low_memory=False,\n    ):\n        keys = chunk[registration_source_col].map(normalize_registration)\n        mask = keys.isin(needed)\n        if not mask.any():\n            continue\n        sub = chunk.loc[mask].copy()\n        sub['_registration_key_v4'] = keys.loc[mask].values\n        for _, row in sub.iterrows():\n            key = row['_registration_key_v4']\n            matched_keys.add(key)\n            bucket = registry_lookup[object_type].setdefault(key, {\n                'authors_text': '', 'holders_text': '', 'ipc_text': '', 'locarno_text': '', 'country_text': ''\n            })\n            authors, holders, ipc, locarno, countries = [], [], [], [], []\n            for column in selected:\n                if column == registration_source_col:\n                    continue\n                value = row.get(column, '')\n                if is_blank(value):\n                    continue\n                col_key = norm_col(column)\n                if 'author' in col_key or 'автор' in col_key or 'inventor' in col_key:\n                    authors.append(str(value))\n                if 'holder' in col_key or 'правооблад' in col_key:\n                    holders.append(str(value))\n                if 'ipc' in col_key or 'мпк' in col_key:\n                    ipc.append(str(value))\n                if 'locarno' in col_key or 'локарно' in col_key:\n                    locarno.append(str(value))\n                if 'country' in col_key or 'страна' in col_key:\n                    countries.append(str(value))\n            for field, values in [\n                ('authors_text', authors), ('holders_text', holders), ('ipc_text', ipc),\n                ('locarno_text', locarno), ('country_text', countries),\n            ]:\n                existing = bucket[field]\n                joined = ' | '.join(values)\n                if joined and joined not in existing:\n                    bucket[field] = (existing + ' | ' + joined).strip(' |')\n\n    registry_qc.append({\n        'object_type': object_type,\n        'source_file': str(path),\n        'needed_unique_registration_numbers': len(needed),\n        'matched_unique_registration_numbers': len(matched_keys),\n        'match_share': round(len(matched_keys) / len(needed), 6) if needed else np.nan,\n    })\n    print(object_type, ':', len(matched_keys), '/', len(needed), 'номеров найдены в исходном реестре')\n\n# ============================================================\n# 5. ФИНАЛЬНЫЕ ПЕРЕМЕННЫЕ\n# ============================================================\n\ndef row_columns(row: pd.Series, fragments: Iterable[str]) -> list[Any]:\n    result = []\n    fragments_norm = [norm_col(item) for item in fragments]\n    for column in row.index:\n        key = norm_col(column)\n        if any(fragment in key for fragment in fragments_norm):\n            value = row[column]\n            if not is_blank(value):\n                result.append(value)\n    return result\n\nauthor_countries_final = []\nholder_countries_final = []\nforeign_author_countries_final = []\nforeign_holder_countries_final = []\nauthor_country_source_final = []\nholder_country_source_final = []\nregistration_country_final = []\nfamily_countries_final = []\nforeign_family_countries_final = []\nroute_codes_final = []\ninternational_patent_final = []\ninternational_basis_final = []\nipc_rospatent_final = []\nipc_google_final = []\nipc_codes_final = []\nipc_source_final = []\ncpc_codes_final = []\nlocarno_codes_final = []\nforward_count_final = []\ncited_flag_final = []\ndigital_international_collaboration_final = []\nall_country_codes_final = []\n\nfor _, row in final.iterrows():\n    object_type = row['object_type']\n    reg_key = row['registration_key_v4']\n    registry = registry_lookup.get(object_type, {}).get(reg_key, {})\n\n    # Страны авторов: исходный реестр + уже существующие поля итоговой книги.\n    author_registry = extract_codes_from_value(registry.get('authors_text', ''))\n    author_existing: set[str] = set()\n    for value in row_columns(row, ['author_country', 'inventor_country', 'foreign_author_country']):\n        author_existing |= extract_simple_code_list(value)\n    authors = (author_registry | author_existing) & ISO2_CODES\n    author_source = []\n    if author_registry:\n        author_source.append('rospatent_registry')\n    if author_existing:\n        author_source.append('existing_final_fields')\n    if not authors:\n        authors = {'RU'}\n        author_source.append('default_ru_no_foreign_code')\n\n    # Страны правообладателей: исходный реестр + уже существующие поля итоговой книги.\n    holder_registry = extract_codes_from_value(registry.get('holders_text', ''))\n    holder_existing: set[str] = set()\n    for value in row_columns(row, ['holder_country', 'assignee_country', 'right_holder_country', 'foreign_holder_country']):\n        holder_existing |= extract_simple_code_list(value)\n    holders = (holder_registry | holder_existing) & ISO2_CODES\n    holder_source = []\n    if holder_registry:\n        holder_source.append('rospatent_registry')\n    if holder_existing:\n        holder_source.append('existing_final_fields')\n    if not holders:\n        holders = {'RU'}\n        holder_source.append('default_ru_no_foreign_code')\n\n    foreign_authors = authors - {'RU'}\n    foreign_holders = holders - {'RU'}\n\n    # Международность классических патентов.\n    family_codes: set[str] = set()\n    routes: set[str] = set()\n    for candidate in [\n        'gp_family_country_codes_final', 'gp_family_country_codes', 'family_country_codes_final',\n        'gp_foreign_country_codes_final', 'gp_foreign_country_codes', 'foreign_country_codes_final',\n    ]:\n        if candidate in row.index and not is_blank(row[candidate]):\n            family_codes |= extract_simple_code_list(row[candidate])\n    for candidate in [\n        'gp_route_codes_final', 'gp_route_codes', 'international_route_codes_final',\n        'gp_international_route_codes',\n    ]:\n        if candidate in row.index and not is_blank(row[candidate]):\n            routes |= extract_routes(row[candidate])\n\n    routes |= family_codes & ROUTE_CODES\n    family_codes -= ROUTE_CODES\n    foreign_family = family_codes - {'RU'}\n\n    if object_type == 'Промышленный образец':\n        family = {'RU'}\n        foreign_family = set()\n        routes = set()\n        international = 0\n        basis = 'industrial_design_ru_only_accepted'\n    elif object_type in {'Изобретение', 'Полезная модель'}:\n        family = {'RU'} | foreign_family\n        international = int(bool(foreign_family or routes))\n        if foreign_family and routes:\n            basis = 'foreign_country_and_route'\n        elif foreign_family:\n            basis = 'foreign_country'\n        elif routes:\n            basis = 'international_route'\n        else:\n            basis = 'ru_only_no_foreign_evidence'\n    else:\n        family = {'RU'}\n        foreign_family = set()\n        routes = set()\n        international = 0\n        basis = 'not_applicable_digital_object'\n\n    # IPC: исходный Роспатент + безопасные Google-поля.\n    ipc_rospatent = extract_ipc(registry.get('ipc_text', ''))\n    ipc_google: set[str] = set()\n    cpc_google: set[str] = set()\n    for column in row.index:\n        key = norm_col(column)\n        value = row[column]\n        if is_blank(value):\n            continue\n        if ('gp' in key or 'google' in key) and 'ipc' in key:\n            ipc_google |= extract_ipc(value)\n        if ('gp' in key or 'google' in key) and 'cpc' in key:\n            cpc_google |= extract_cpc(value)\n    existing_ipc: set[str] = set()\n    for candidate in ['classification_codes_final', 'ipc_codes_final', 'ipc_final']:\n        if candidate in row.index and not is_blank(row[candidate]):\n            existing_ipc |= extract_ipc(row[candidate])\n    ipc_union = ipc_rospatent | ipc_google | existing_ipc\n    if ipc_rospatent and ipc_google:\n        ipc_source = 'rospatent+google'\n    elif ipc_rospatent:\n        ipc_source = 'rospatent'\n    elif ipc_google:\n        ipc_source = 'google'\n    elif existing_ipc:\n        ipc_source = 'existing_final_field'\n    else:\n        ipc_source = 'missing'\n\n    locarno = extract_locarno(registry.get('locarno_text', ''))\n    for column in row.index:\n        if 'locarno' in norm_col(column) and not is_blank(row[column]):\n            locarno |= extract_locarno(row[column])\n\n    # Прямые цитирования.\n    if object_type == 'Промышленный образец':\n        forward_count = 0\n        cited_flag = 0\n    elif object_type in {'Изобретение', 'Полезная модель'}:\n        forward_count = None\n        for candidate in [\n            'gp_forward_citation_count', 'gp_forward_citations_count',\n            'citations_forward_count_enriched', 'forward_citation_count_final',\n        ]:\n            if candidate in row.index:\n                numeric = pd.to_numeric(pd.Series([row[candidate]]), errors='coerce').iloc[0]\n                if pd.notna(numeric):\n                    forward_count = int(numeric)\n                    break\n        if forward_count is None:\n            forward_count = 0\n            for candidate in ['gp_forward_citations', 'gp_forward_citations_json', 'forward_citations_json']:\n                if candidate in row.index and not is_blank(row[candidate]):\n                    parsed = parse_structured(row[candidate])\n                    if isinstance(parsed, (list, tuple, set)):\n                        forward_count = max(forward_count, len(parsed))\n        cited_flag = int(forward_count > 0)\n    else:\n        forward_count = np.nan\n        cited_flag = np.nan\n\n    digital_collaboration = int(bool(foreign_holders)) if object_type in DIGITAL_TYPES else np.nan\n    all_countries = {'RU'} | authors | holders | family\n\n    author_countries_final.append(serialize(authors))\n    holder_countries_final.append(serialize(holders))\n    foreign_author_countries_final.append(serialize(foreign_authors))\n    foreign_holder_countries_final.append(serialize(foreign_holders))\n    author_country_source_final.append('+'.join(author_source))\n    holder_country_source_final.append('+'.join(holder_source))\n    registration_country_final.append('RU')\n    family_countries_final.append(serialize(family))\n    foreign_family_countries_final.append(serialize(foreign_family))\n    route_codes_final.append(serialize(routes))\n    international_patent_final.append(international)\n    international_basis_final.append(basis)\n    ipc_rospatent_final.append(serialize(ipc_rospatent))\n    ipc_google_final.append(serialize(ipc_google))\n    ipc_codes_final.append(serialize(ipc_union))\n    ipc_source_final.append(ipc_source)\n    cpc_codes_final.append(serialize(cpc_google))\n    locarno_codes_final.append(serialize(locarno))\n    forward_count_final.append(forward_count)\n    cited_flag_final.append(cited_flag)\n    digital_international_collaboration_final.append(digital_collaboration)\n    all_country_codes_final.append(serialize(all_countries))\n\nfinal['registration_country_final'] = registration_country_final\nfinal['author_country_codes_final'] = author_countries_final\nfinal['foreign_author_country_codes_final'] = foreign_author_countries_final\nfinal['author_country_source_final'] = author_country_source_final\nfinal['holder_country_codes_final'] = holder_countries_final\nfinal['foreign_holder_country_codes_final'] = foreign_holder_countries_final\nfinal['holder_country_source_final'] = holder_country_source_final\nfinal['family_country_codes_final_v4'] = family_countries_final\nfinal['foreign_family_country_codes_final_v4'] = foreign_family_countries_final\nfinal['international_route_codes_final_v4'] = route_codes_final\nfinal['international_patent_flag_final_v4'] = international_patent_final\nfinal['international_basis_final_v4'] = international_basis_final\nfinal['ipc_codes_rospatent_v4'] = ipc_rospatent_final\nfinal['ipc_codes_google_v4'] = ipc_google_final\nfinal['ipc_codes_final_v4'] = ipc_codes_final\nfinal['ipc_source_final_v4'] = ipc_source_final\nfinal['cpc_codes_final_v4'] = cpc_codes_final\nfinal['locarno_codes_final_v4'] = locarno_codes_final\nfinal['forward_citation_count_final_v4'] = forward_count_final\nfinal['cited_patent_flag_final_v4'] = cited_flag_final\nfinal['digital_international_collaboration_flag_final_v4'] = digital_international_collaboration_final\nfinal['all_country_codes_final_v4'] = all_country_codes_final\nfinal['foreign_author_present_flag_v4'] = final['foreign_author_country_codes_final'].astype(str).str.strip().ne('').astype(int)\nfinal['foreign_holder_present_flag_v4'] = final['foreign_holder_country_codes_final'].astype(str).str.strip().ne('').astype(int)\nfinal['classification_available_flag_v4'] = final['ipc_codes_final_v4'].astype(str).str.strip().ne('').astype(int)\n\n# ============================================================\n# 6. КОНТРОЛЬ КАЧЕСТВА\n# ============================================================\n\nqc_rows = []\ndef qc(check: str, value: Any, expected: str, passed: bool, note: str = '') -> None:\n    qc_rows.append({'check': check, 'value': value, 'expected': expected, 'passed': int(bool(passed)), 'note': note})\n\nqc('Удалено невалидных patent_key', len(bad_keys), '1', len(bad_keys) == 1)\nremaining_bad = 0\nif status_col:\n    remaining_bad = int(final[status_col].fillna('').astype(str).str.casefold().eq('parse_validation_failed').sum())\nqc('Остались parse_validation_failed', remaining_bad, '0', remaining_bad == 0)\nqc('Строк в итоговой базе', len(final), '> 0', len(final) > 0)\nqc('Уникальных объектов', final[patent_key_col].nunique(), '> 0', final[patent_key_col].nunique() > 0)\nduplicate_pairs = int(final.duplicated([patent_key_col, university_col]).sum())\nqc('Дубли patent_key + university', duplicate_pairs, '0', duplicate_pairs == 0)\nfor column in ['registration_country_final', 'author_country_codes_final', 'holder_country_codes_final']:\n    missing = int(final[column].fillna('').astype(str).str.strip().eq('').sum())\n    qc(f'Пустые значения {column}', missing, '0', missing == 0)\n\ndesign_mask = final['object_type'].eq('Промышленный образец')\nbad_design_int = int(pd.to_numeric(final.loc[design_mask, 'international_patent_flag_final_v4'], errors='coerce').fillna(-1).ne(0).sum())\nbad_design_cited = int(pd.to_numeric(final.loc[design_mask, 'cited_patent_flag_final_v4'], errors='coerce').fillna(-1).ne(0).sum())\nqc('Промышленные образцы с международностью не 0', bad_design_int, '0', bad_design_int == 0)\nqc('Промышленные образцы с цитируемостью не 0', bad_design_cited, '0', bad_design_cited == 0)\n\nclassic_ipc_mask = final['object_type'].isin(['Изобретение', 'Полезная модель'])\nipc_coverage = float(final.loc[classic_ipc_mask, 'ipc_codes_final_v4'].astype(str).str.strip().ne('').mean())\nqc('Заполненность итогового МПК', round(ipc_coverage, 4), 'информационно', True, 'Объединение Роспатента и Google')\nqc_df = pd.DataFrame(qc_rows)\nregistry_qc_df = pd.DataFrame(registry_qc)\n\nsummary = final.groupby('object_type', dropna=False).agg(\n    rows=(patent_key_col, 'size'),\n    unique_objects=(patent_key_col, 'nunique'),\n    universities=(university_col, 'nunique'),\n    international_objects=('international_patent_flag_final_v4', lambda s: int(pd.to_numeric(s, errors='coerce').fillna(0).gt(0).sum())),\n    cited_objects=('cited_patent_flag_final_v4', lambda s: int(pd.to_numeric(s, errors='coerce').fillna(0).gt(0).sum())),\n    foreign_author_rows=('foreign_author_present_flag_v4', 'sum'),\n    foreign_holder_rows=('foreign_holder_present_flag_v4', 'sum'),\n    ipc_available_rows=('classification_available_flag_v4', 'sum'),\n).reset_index()\n\nreadme = pd.DataFrame([\n    {'parameter': 'Версия', 'value': VERSION},\n    {'parameter': 'Исходная книга', 'value': str(INPUT_XLSX)},\n    {'parameter': 'Правило международности', 'value': 'Есть подтвержденная зарубежная страна или маршрут — 1; иначе RU и 0'},\n    {'parameter': 'Промышленные образцы', 'value': 'Сохранены; RU; международность 0; цитируемость 0'},\n    {'parameter': 'Страны авторов', 'value': 'Исходные реестры Роспатента + существующие поля; при отсутствии иностранного кода консервативно RU'},\n    {'parameter': 'Страны правообладателей', 'value': 'Исходные реестры Роспатента + существующие поля; при отсутствии иностранного кода консервативно RU'},\n    {'parameter': 'Страна регистрации', 'value': 'RU для всех объектов из российских государственных реестров'},\n    {'parameter': 'Создано UTC', 'value': datetime.now(timezone.utc).isoformat()},\n])\n\n# ============================================================\n# 7. СОХРАНЕНИЕ\n# ============================================================\n\ndef parquet_safe(df: pd.DataFrame) -> pd.DataFrame:\n    result = df.copy()\n    for column in result.select_dtypes(include=['object']).columns:\n        result[column] = result[column].map(lambda value: None if is_blank(value) else str(value))\n    return result\n\ndef excel_safe(df: pd.DataFrame) -> pd.DataFrame:\n    result = df.copy()\n    for column in result.select_dtypes(include=['object']).columns:\n        result[column] = result[column].map(lambda value: '' if is_blank(value) else str(value)[:32700])\n    return result\n\nparquet_safe(final).to_parquet(OUTPUT_PARQUET, index=False)\nfinal.to_csv(OUTPUT_CSV, index=False, encoding='utf-8-sig')\n\nSHEET_NAMES = {\n    'Изобретение': 'Изобретения',\n    'Полезная модель': 'Полезные модели',\n    'Промышленный образец': 'Промышленные образцы',\n    'Программа для ЭВМ': 'Программы ЭВМ',\n    'База данных': 'Базы данных',\n    'ТИМС': 'ТИМС',\n}\n\nwith pd.ExcelWriter(OUTPUT_XLSX, engine='xlsxwriter', engine_kwargs={'options': {'strings_to_urls': False}}) as writer:\n    excel_safe(readme).to_excel(writer, sheet_name='4_README', index=False)\n    excel_safe(qc_df).to_excel(writer, sheet_name='4_QC_финал', index=False)\n    excel_safe(registry_qc_df).to_excel(writer, sheet_name='4_QC_Роспатент', index=False)\n    excel_safe(summary).to_excel(writer, sheet_name='4_Сводка_типы', index=False)\n    excel_safe(removed).to_excel(writer, sheet_name='4_Удаленный объект', index=False)\n    for object_type in OBJECT_TYPES:\n        subset = final.loc[final['object_type'].eq(object_type)].copy()\n        excel_safe(subset).to_excel(writer, sheet_name=SHEET_NAMES[object_type], index=False)\n\n    workbook = writer.book\n    header = workbook.add_format({'bold': True, 'text_wrap': True, 'valign': 'top', 'border': 1})\n    for sheet_name, worksheet in writer.sheets.items():\n        worksheet.freeze_panes(1, 0)\n        current = None\n        if sheet_name == '4_README': current = readme\n        elif sheet_name == '4_QC_финал': current = qc_df\n        elif sheet_name == '4_QC_Роспатент': current = registry_qc_df\n        elif sheet_name == '4_Сводка_типы': current = summary\n        elif sheet_name == '4_Удаленный объект': current = removed\n        else:\n            reverse = {value: key for key, value in SHEET_NAMES.items()}\n            if sheet_name in reverse:\n                current = final.loc[final['object_type'].eq(reverse[sheet_name])]\n        if current is None or len(current.columns) == 0:\n            continue\n        worksheet.autofilter(0, 0, len(current), len(current.columns) - 1)\n        for index, column in enumerate(current.columns):\n            worksheet.write(0, index, str(column), header)\n            key = norm_col(column)\n            width = 28 if any(fragment in key for fragment in ['json', 'abstract', 'holder', 'author', 'title', 'name', 'правооблад', 'автор']) else 18\n            worksheet.set_column(index, index, width)\n\nprint('\\n' + '=' * 72)\nprint('ГОТОВО')\nprint('=' * 72)\nprint('Исходный файл:', INPUT_XLSX)\nprint('Строк:', f'{len(final):,}')\nprint('Уникальных объектов:', f'{final[patent_key_col].nunique():,}'